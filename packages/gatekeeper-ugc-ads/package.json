{
  "name": "@gadgets/gatekeeper-ugc-ads",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "pnpm run build:skills && wrangler deploy",
    "build:skills": "node scripts/build-skills.mjs",
    "build": "pnpm run build:skills && tsc",
    "types:check": "pnpm run build:skills && tsc --noEmit",
    "test": "pnpm run build:skills && vitest run && vitest run --config vitest.production.config.ts",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "@gadgets/backend-utils": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "miniflare": "5.20260801.0-alpha",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
