{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-creator-buddy",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm run build:skills && pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src",
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["nodejs_compat", "allow_irrevocable_stub_storage"],
  // Renders self-contained vendored HTML templates (covers and diagrams) to images.
  "browser": {
    "binding": "BROWSER",
  },
  // DO classes are reached via ctx.exports; no durable_objects binding needed.
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["CreatorBuddyGatekeeper"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
