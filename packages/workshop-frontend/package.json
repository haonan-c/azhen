{
  "name": "@gadgets/workshop-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "paraglide:compile": "node compile-paraglide.mjs",
    "prebuild": "pnpm paraglide:compile",
    "build": "tsc && vite build",
    "pretypes:check": "pnpm paraglide:compile",
    "types:check": "tsc --noEmit",
    "pretest": "pnpm paraglide:compile",
    "test": "vitest run --exclude '**/build-artifacts.test.mjs' && vitest run build-artifacts.test.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.2",
    "@gadgets/error-reporting": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.21",
    "capnweb": "catalog:",
    "hash-wasm": "^4.12.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@tanstack/router-plugin": "^1.168.26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
