{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  // Gatekeeper service bindings (GATEKEEPER_*) are added dynamically at deploy time — by the
  // deploy service for customer instances, from the release manifest's binding templates. Only
  // the static backend binding is checked in.
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "workshop-backend"
    }
  ],

  // The router owns the public origin for customer instances, so it serves the frontend.
  // `run_worker_first` sends documents and dynamic routes through the Router. Built frontend
  // assets keep their direct Asset Worker path; unmatched application routes use SPA fallback
  // after the Router applies the page SEO boundary.
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/marketing/*"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
